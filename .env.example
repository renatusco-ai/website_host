# Server-only. Never prefix these with VITE_ — that would expose them in the browser.
RESEND_API_KEY=
RESEND_FROM=Renatus <shaun@renatusco.com>
ENQUIRY_TO=shaun@renatusco.com

# Supabase (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Supabase anon/publishable key used on the server for staff email/password sign-in
SUPABASE_ANON_KEY=
# Optional Renatus staff allowlists in addition to Supabase app_metadata.role / app_metadata.renatus_staff
INTAKE_STAFF_USER_IDS=
INTAKE_STAFF_EMAILS=
INTAKE_STAFF_EMAIL_DOMAINS=
# Set for a custom earlier bucket. The default is app-store-intake-assets.
SUPABASE_INTAKE_LEGACY_BUCKET=
# Set to legacy during preparation or rollback. The default writes prefixed uploads.
INTAKE_UPLOAD_WRITE_MODE=
RATE_LIMIT_SALT=

# Optional Cloudflare Turnstile anti-bot protection
TURNSTILE_SECRET_KEY=
